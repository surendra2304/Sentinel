# ==============================================================================
# SENTINEL — Production Environment Configuration (.env.example)
# Autonomous Security Watchdog & Cryptographic Signing Gatekeeper (HMAC/ECDSA)
# FRIDAY Universe Modernized Mesh (Oracle Cloud Always Free)
# Copy to .env and configure secrets — NEVER commit real secrets to git
# ==============================================================================

# ── Container & Network Topology ──────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
SENTINEL_ENVIRONMENT=production
SENTINEL_DEBUG=false
SENTINEL_API_HOST=0.0.0.0
SENTINEL_API_PORT=8000
SENTINEL_API_PREFIX=/api/v1
SENTINEL_CORS_ORIGINS=https://friday-universe.duckdns.org

# ── Security & Cryptographic Gatekeeper Keys ──────────────────────────────────
# Required: 32+ character high-entropy keys for HMAC-SHA256, ECDSA, & Capabilities
SENTINEL_API_AUTH_REQUIRED=true
SENTINEL_API_KEY=replace_with_strong_random_32char_api_key
SENTINEL_AUDIT_SIGNING_KEY=replace_with_strong_random_32char_audit_signing_key
SENTINEL_AUDIT_HMAC_KEY=replace_with_strong_random_32char_audit_hmac_key
SENTINEL_CAPABILITY_SIGNING_KEY=replace_with_strong_random_32char_capability_key

# Optional: PEM-encoded private key for custom ECDSA SECP256R1 signatures
# If omitted, Sentinel deterministically derives ECDSA key material from master secret
SENTINEL_ECDSA_PRIVATE_KEY=

# ── VyralX YouTube Publish Policy (deny by default) ───────────────────────────
# Enable only after VyralX's source-rights checks and operator review are verified.
SENTINEL_YOUTUBE_PUBLISH_ENABLED=false
SENTINEL_YOUTUBE_PUBLISH_ALLOW_UNLISTED=false
SENTINEL_YOUTUBE_PUBLISH_ALLOW_PUBLIC=false

# ── Storage & Durability Backends ─────────────────────────────────────────────
# Oracle Autonomous Database only. PostgreSQL/SQLite are not supported.
# Leave SENTINEL_STORAGE_BACKEND unset (defaults to oracle) or set it explicitly.
SENTINEL_STORAGE_BACKEND=oracle
SENTINEL_DATABASE_URL=oracle+oracledb://SENTINEL:password@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.REGION.oraclecloud.com))(connect_data=(service_name=SERVICE_NAME))(security=(ssl_server_dn_match=yes)))

# Object Storage (MinIO or S3-compatible, or "local")
SENTINEL_S3_BACKEND=s3
SENTINEL_S3_ENDPOINT=minio:9000
SENTINEL_S3_ACCESS_KEY=replace_with_minio_access_key
SENTINEL_S3_SECRET_KEY=replace_with_minio_secret_key
SENTINEL_S3_BUCKET_NAME=sentinel-evidence

# ── Audit Log Ledger ──────────────────────────────────────────────────────────
SENTINEL_AUDIT_LOG_FILE_PATH=logs/audit.jsonl

# ── Concurrency & Admission Limits ────────────────────────────────────────────
SENTINEL_MAX_HTTP_CONCURRENCY=256
SENTINEL_MAX_HEALTH_CONCURRENCY=16
SENTINEL_MAX_AGENT_PROPOSALS_PER_TASK=8
SENTINEL_MAX_PLAN_STEPS_PER_ITERATION=16
SENTINEL_MAX_ACTIONS_PER_AGENT_PER_TASK=32
SENTINEL_MAX_AGENT_ANALYSIS_SECONDS=15
SENTINEL_MAX_TASK_ITERATIONS=10

# ── FRIDAY Universe Container Mesh (friday_mesh) ──────────────────────────────
# Intra-mesh communication routed directly across Docker network
INFERENCE_URL=http://inference:8000
INFERENCE_API_KEY=
MEMORA_URL=http://memora:8000
MEMORA_API_KEY=
STRATEX_URL=http://stratex:8000
STRATEX_API_KEY=
INTELX_URL=http://intelx:8000
INTELX_API_KEY=
FUTURIS_URL=http://futuris:8000
FUTURIS_API_KEY=
CORTEX_URL=http://cortex:8000
CORTEX_API_KEY=
FORGE_URL=http://forge:8000
FORGE_API_KEY=
SENTINEL_URL=http://sentinel:8000
FRIDAY_URL=http://friday:10000
FRIDAY_API_KEY=

# Outbound HTTP certificate validation (enabled by default).
SENTINEL_TLS_VERIFY=true
# Break-glass only for explicitly approved production assessments against self-signed hosts.
SENTINEL_ALLOW_INSECURE_TLS_PRODUCTION=false

# --- AGENT 10 VYRALX MESH ---
VYRALX_URL=http://vyralx:8000
VYRALX_API_KEY=

# ── External Threat Intelligence & Vulnerability Enrichment ──────────────────
SHODAN_API_KEY=
NVD_API_KEY=
VIRUSTOTAL_API_KEY=

# ── Policy Tuning & Veto Enforcement ──────────────────────────────────────────
SENTINEL_BLOCK_ON_MEDIUM_CVES=false
SENTINEL_AUTO_KILL_SWITCH_ENABLED=false
SENTINEL_DOCKER_SOCKET_PATH=/var/run/docker.sock
