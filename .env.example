# SENTINEL Environment Configuration
# Copy to .env and fill in values — NEVER commit .env to version control

# Environment: development | staging | production
SENTINEL_ENVIRONMENT=development
SENTINEL_DEBUG=false

# Database (PostgreSQL)
SENTINEL_DB_HOST=localhost
SENTINEL_DB_PORT=5432
SENTINEL_DB_USER=sentinel
SENTINEL_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SENTINEL_DB_NAME=sentinel_db

# Object Storage (MinIO / S3-compatible, or local filesystem)
SENTINEL_S3_BACKEND=local
SENTINEL_S3_ENDPOINT=localhost:9000
SENTINEL_S3_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
SENTINEL_S3_SECRET_KEY=CHANGE_ME_SECRET_KEY
SENTINEL_S3_BUCKET_NAME=sentinel-evidence

# API Security
SENTINEL_API_KEY=CHANGE_ME_64CHAR_RANDOM_API_KEY
SENTINEL_FRIDAY_API_KEY=CHANGE_ME_FRIDAY_SERVICE_KEY
SENTINEL_API_RATE_LIMIT=100/minute

# LLM Intelligence Provider (optional - leave blank for offline heuristic mode)
SENTINEL_LLM_BASE_URL=https://api.openai.com/v1
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_MODEL=gpt-4o-mini

# Audit
SENTINEL_AUDIT_LOG_FILE=logs/audit.jsonl
SENTINEL_AUDIT_SIGNING_KEY=CHANGE_ME_HMAC_SIGNING_KEY

# Security notices:
# - Never store real API keys or credentials in this file when committed
# - Rotate all credentials after initial deployment
# - Use a secrets manager (Vault, AWS Secrets Manager) in production