{
  "$defs": {
    "AuthorizationMetadata": {
      "description": "Authorization context and legal boundaries.",
      "properties": {
        "authorization_type": {
          "$ref": "#/$defs/AuthorizationType",
          "default": "owned"
        },
        "reference_ticket_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Ticket Id"
        },
        "authorized_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorized By"
        },
        "expiry": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expiry"
        }
      },
      "title": "AuthorizationMetadata",
      "type": "object"
    },
    "AuthorizationType": {
      "enum": [
        "owned",
        "written_consent",
        "bug_bounty",
        "authorized_engagement",
        "unauthorized"
      ],
      "title": "AuthorizationType",
      "type": "string"
    },
    "EnvironmentLabel": {
      "enum": [
        "development",
        "testing",
        "staging",
        "production",
        "external"
      ],
      "title": "EnvironmentLabel",
      "type": "string"
    },
    "ImpactLevel": {
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "ImpactLevel",
      "type": "string"
    },
    "TimeWindow": {
      "description": "Explicit, bounded authorization time window.",
      "properties": {
        "start_time": {
          "format": "date-time",
          "title": "Start Time",
          "type": "string"
        },
        "end_time": {
          "format": "date-time",
          "title": "End Time",
          "type": "string"
        }
      },
      "required": [
        "start_time",
        "end_time"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "description": "Scope boundaries, target allowlists, and restrictions.",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "allowed_targets": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Targets",
      "type": "array"
    },
    "in_scope_declarations": {
      "items": {
        "type": "string"
      },
      "title": "In Scope Declarations",
      "type": "array"
    },
    "out_of_scope_declarations": {
      "items": {
        "type": "string"
      },
      "title": "Out Of Scope Declarations",
      "type": "array"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentLabel",
      "default": "production"
    },
    "authorization": {
      "$ref": "#/$defs/AuthorizationMetadata"
    },
    "max_intensity": {
      "default": 5,
      "maximum": 10,
      "minimum": 1,
      "title": "Max Intensity",
      "type": "integer"
    },
    "offensive_actions_enabled": {
      "default": false,
      "title": "Offensive Actions Enabled",
      "type": "boolean"
    },
    "owner": {
      "default": "security_operator",
      "title": "Owner",
      "type": "string"
    },
    "written_authorization_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Written Authorization Reference"
    },
    "targets": {
      "items": {
        "type": "string"
      },
      "title": "Targets",
      "type": "array"
    },
    "excluded_targets": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Targets",
      "type": "array"
    },
    "allowed_methods": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Methods",
      "type": "array"
    },
    "time_window": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeWindow"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rate_limit": {
      "default": 50,
      "maximum": 1000,
      "minimum": 1,
      "title": "Rate Limit",
      "type": "integer"
    },
    "maximum_impact": {
      "$ref": "#/$defs/ImpactLevel",
      "default": "low"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "Scope",
  "type": "object",
  "schema_version": "1.0.0"
}