{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FridayDelegationContract",
  "type": "object",
  "required": ["capability", "objective", "targets", "mode", "requested_output"],
  "properties": {
    "capability": {
      "type": "string",
      "enum": ["sentinel.security_assessment", "sentinel.reconnaissance", "sentinel.incident_investigation"]
    },
    "objective": { "type": "string", "minLength": 5 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "mode": { "type": "string" },
    "requested_output": {
      "type": "string",
      "enum": ["technical_and_executive", "summary", "detailed_report", "alert", "remediation_plan"]
    },
    "policy_context": {
      "type": "object",
      "properties": {
        "environment": { "type": "string" },
        "authorization_reference": { "type": "string" },
        "constraints": { "type": "object" }
      }
    },
    "time_budget_seconds": { "type": "integer", "minimum": 1 },
    "resource_constraints": { "type": "object" }
  }
}
