{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QualityReviewResponse",
  "type": "object",
  "required": ["reviewed_findings", "overall_confidence"],
  "properties": {
    "reviewed_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "verdict", "confidence_adjustment"],
        "properties": {
          "finding_id": {"type": "string"},
          "verdict": {"type": "string", "enum": ["pass", "weak", "flag"]},
          "confidence_adjustment": {"type": "number"},
          "flag_reason": {"type": ["string", "null"]}
        }
      }
    },
    "overall_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "total_flagged": {"type": "integer"}
  }
}
