{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanningResponse",
  "type": "object",
  "required": ["plan_id", "task_id", "steps", "reasoning_trace", "is_terminal"],
  "properties": {
    "plan_id": {"type": "string"},
    "task_id": {"type": "string"},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent", "action_type", "phase", "justification"],
        "properties": {
          "agent": {"type": "string"},
          "action_type": {"type": "string"},
          "phase": {"type": "string"},
          "justification": {"type": "string"}
        }
      }
    },
    "reasoning_trace": {"type": "array", "items": {"type": "string"}},
    "is_terminal": {"type": "boolean"},
    "confidence_is_sufficient": {"type": "boolean"},
    "phases_covered": {"type": "array", "items": {"type": "string"}}
  }
}
