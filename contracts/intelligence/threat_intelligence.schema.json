{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ThreatIntelligenceResponse",
  "type": "object",
  "required": ["ioc_type", "verdict", "confidence", "threat_actor_hints", "kill_chain_phase"],
  "properties": {
    "ioc_type": {"type": "string", "enum": ["ip", "domain", "hash", "cve", "url", "unknown"]},
    "verdict": {"type": "string", "enum": ["benign", "suspicious", "confirmed", "unverified"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "threat_actor_hints": {"type": "array", "items": {"type": "string"}},
    "kill_chain_phase": {"type": "string"}
  }
}
